# =====================================================================
#  AI DEV BOT — Configuration
#  Copy this file to `.env` and fill in the values. NEVER commit `.env`.
#  Guiding rule: the ONLY paid dependency allowed is Claude Code.
#  Everything else MUST use a free tier.
# =====================================================================

# ---- Telegram (REQUIRED) --------------------------------------------
# Create a bot via @BotFather -> get the token.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (get it from @userinfobot).
# Only this user can control the bot. Everyone else is rejected.
TELEGRAM_ALLOWED_USER_ID=

# ---- Claude Code (REQUIRED — the ONLY paid worker) ------------------
# The standalone CLI, installed via:  npm i -g @anthropic-ai/claude-code
# It authenticates with your existing Claude Pro/Max subscription
# (run `claude` once interactively to log in). No extra cost beyond that.
# On Windows this is usually claude.cmd on your PATH.
CLAUDE_COMMAND=claude
# Which subscription you have: affects usage-limit budgeting (pro | max).
CLAUDE_PLAN=pro
# Hard safety cap: max Claude Code invocations per project (0 = unlimited).
CLAUDE_MAX_CALLS_PER_PROJECT=40
# Hard safety cap: max Claude Code invocations per day across all projects.
CLAUDE_MAX_CALLS_PER_DAY=150
# Timeout for a single Claude Code task, in seconds.
CLAUDE_TIMEOUT_SECONDS=1800

# ---- FREE AI providers (cheap glue only — never in the decision path)
# Used ONLY for: log summarization, error triage, NL->JSON parsing,
# and as a fallback if Claude Code is temporarily unavailable.
# Leave any blank to disable that provider. All are free-tier.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Free model ids (override if the free catalog changes).
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Behaviour ------------------------------------------------------
# Autonomy: low = ask before major actions, medium = ask on risky only,
# high = run normal dev autonomously (destructive actions always ask).
AUTONOMY_LEVEL=high
# Self-healing: how many fix->retest cycles before asking a human.
MAX_RETRIES=3
# Daily status digest time (24h, local machine time).
DAILY_UPDATE_TIME=21:00

# ---- Paths ----------------------------------------------------------
WORKSPACES_DIR=workspaces
STATE_DB_PATH=data/state.db
LOGS_DIR=logs
