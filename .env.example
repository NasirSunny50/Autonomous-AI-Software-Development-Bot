# =====================================================================
#  AI DEV BOT — Configuration
#  Copy this file to `.env` and fill in the values. NEVER commit `.env`.
#  Guiding rule: the ONLY paid dependency allowed is Claude Code.
#  Everything else MUST use a free tier.
# =====================================================================

# ---- Telegram (REQUIRED) --------------------------------------------
# Create a bot via @BotFather -> get the token.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (get it from @userinfobot).
# Only this user can control the bot. Everyone else is rejected.
TELEGRAM_ALLOWED_USER_ID=

# ---- Claude Code (REQUIRED — the ONLY paid worker) ------------------
# The standalone CLI, installed via:  npm i -g @anthropic-ai/claude-code
# It authenticates with your existing Claude Pro/Max subscription
# (run `claude` once interactively to log in). No extra cost beyond that.
# On Windows this is usually claude.cmd on your PATH.
CLAUDE_COMMAND=claude
# Which subscription you have: affects usage-limit budgeting (pro | max).
CLAUDE_PLAN=pro
# Hard safety cap: max Claude Code invocations per project (0 = unlimited).
CLAUDE_MAX_CALLS_PER_PROJECT=40
# Hard safety cap: max Claude Code invocations per day across all projects.
CLAUDE_MAX_CALLS_PER_DAY=150
# Timeout for a single Claude Code task, in seconds.
CLAUDE_TIMEOUT_SECONDS=1800

# ---- FREE AI providers (cheap glue only — never in the decision path)
# Used ONLY for: log summarization, error triage, NL->JSON parsing,
# and as a fallback if Claude Code is temporarily unavailable.
# Leave any blank to disable that provider. All are free-tier.
#   Ollama Cloud (gpt-oss:120b etc.): https://ollama.com/settings/keys  (free tier)
#   Kilo Code gateway (many models): use a FREE model only (see below)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
KILO_API_KEY=
#   Mistral (free experiment tier): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Free model ids (override if the free catalog changes).
# GEMINI_MODEL accepts a COMMA-SEPARATED list — one key can use several models,
# and it falls through to the next one if a model hits its per-model free quota.
GEMINI_MODEL=gemini-2.0-flash,gemini-2.5-flash,gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter/Groq/Kilo model fields also accept a COMMA-SEPARATED list (fallback).
# Keep OpenRouter models to `:free` ids — free models change often, so list a few.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,minimax/minimax-m3:free
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_BASE_URL=https://ollama.com/v1
# Kilo gateway hosts paid models too — keep this FREE (kilo-auto/free or an *:free id).
KILO_MODEL=kilo-auto/free
KILO_BASE_URL=https://api.kilo.ai/api/gateway
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ---- Behaviour ------------------------------------------------------
# Autonomy: low = ask before major actions, medium = ask on risky only,
# high = run normal dev autonomously (destructive actions always ask).
AUTONOMY_LEVEL=high
# Self-healing: how many fix->retest cycles before asking a human.
MAX_RETRIES=3
# Daily status digest time (24h, local machine time).
DAILY_UPDATE_TIME=21:00

# ---- Auto-deploy (optional, all free tiers) -------------------------
# Leave DEPLOY_PROVIDER blank to disable deployment entirely.
# "auto" uses the first provider below that has a token set.
#   vercel     -> best for Next.js / SSR / most frameworks (free hobby tier)
#   cloudflare -> Cloudflare Pages, great for static/exported sites (free)
#   surge      -> dead-simple static hosting (free); static builds only
# Tokens are passed to the CLI via environment only (never logged, never args).
DEPLOY_PROVIDER=
# false = preview deploy (safe default); true = production deploy.
DEPLOY_PROD=false

# Vercel: create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=
# Cloudflare Pages: API token (Pages:Edit) + your account id
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Surge: run `npx surge token` to get a token (static sites only)
SURGE_TOKEN=
SURGE_LOGIN=

# ---- Paths ----------------------------------------------------------
WORKSPACES_DIR=workspaces
STATE_DB_PATH=data/state.db
LOGS_DIR=logs
