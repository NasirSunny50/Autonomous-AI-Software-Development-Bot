# ---- Secrets (NEVER commit) ----
.env
*.env
!.env.example
*.key
*.pem
secrets/
config/*.local.*

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Bot runtime data ----
logs/*.log
logs/**/*.log
data/*.db
data/*.sqlite3
*.sqlite3
state.db

# ---- Managed project workspaces (the bot builds apps here) ----
workspaces/*/
!workspaces/.gitkeep

# ---- Node / Playwright (for the bot's own tooling) ----
node_modules/
playwright-report/
test-results/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
